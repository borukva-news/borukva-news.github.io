# GitHub personal access token with access to the repo below (contents: read/write)
GITHUB_TOKEN=

# Repo that stores the hotspot JSON files (was hardcoded in the Cloudflare Worker)
GITHUB_OWNER=
GITHUB_REPO=

# Port for the Express server
PORT=

# Recommended on Render: HTTPS email provider, because outbound SMTP may time out.
RESEND_API_KEY=
RESEND_FROM=
